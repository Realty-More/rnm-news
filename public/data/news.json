":"Supporting-Image-1024x576.jpeg","width":1024,"height":576,"filesize":86740,"mime_type":"image/jpeg","source_url":"https://realtynmore.com/wp-content/uploads/2026/10/Supporting-Image-1024x576.jpeg"},"thumbnail":{"file":"Supporting-Image-150x84.jpeg","width":150,"height":84,"filesize":4596,"mime_type":"image/jpeg","source_url":"https://realtynmore.com/wp-content/uploads/2026/10/Supporting-Image-150x84.jpeg"},"full":{"file":"Supporting-Image.jpeg","width":2560,"height":1440,"mime_type":"image/jpeg","source_url":"https://realtynmore.com/wp-content/uploads/2026/10/Supporting-Image.jpeg"}}}}],"wp:term":[[{"id":1,"name":"News","slug":"news","taxonomy":"category"}],[]]}},{"id":119508,"slug":"vegas-mall-hosts-max-urb-n-un-mute-rap-tour","date_gmt":"2026-10-26T07:55:01","modified_gmt":"2026-10-26T07:55:04","link":"https://realtynmore.com/vegas-mall-hosts-max-urb-n-un-mute-rap-tour/","title":{"rendered":"Vegas Mall Hosts MAX URB_N UN-MUTE Rap Tour Celebrating Urban Hip-Hop Culture"},"excerpt":{"rendered":"<p>New Delhi, October 26, 2026: Vegas Mall in Dwarka hosted the Delhi edition of the MAX URB_N UN-MUTE Rap Tour, bringing together hip-hop performers, street artists, and urban culture enthusiasts for a celebration of youth culture, according to a press release. The event featured live performances by musicians Reble, Vichaar, Karun with Nanku, and Siyaahi. <a href=\"https://realtynmore.com/vegas-mall-hosts-max-urb-n-un-mute-rap-tour/\" class=\"more-link\">&#8230;<span class=\"screen-reader-text\">  Vegas Mall Hosts MAX URB_N UN-MUTE Rap Tour Celebrating Urban Hip-Hop Culture</span></a></p>\n"},"categories":[1],"_embedded":{"wp:featuredmedia":[{"source_url":"https://realtynmore.com/wp-content/uploads/2026/10/Image-Vegas-Rap-max.jpeg","alt_text":"","media_details":{"width":1280,"height":720,"sizes":{"medium":{"file":"Image-Vegas-Rap-max-374x210.jpeg","width":374,"height":210,"filesize":20101,"mime_type":"image/jpeg","source_url":"https://realtynmore.com/wp-content/uploads/2